# Leave the keys empty to run fully on the built-in stand-ins (no external calls).
PORT=3001
PUBLIC_URL=http://localhost:3001
# Set to 1 to ignore any keys and stay on the stand-ins.
FORCE_MOCK=0

# Claude (agent explanations). Empty = deterministic stand-in agent.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Local development only: account = run the model through your Claude Code login (never uses ANTHROPIC_API_KEY).
LLM_BACKEND=

# App sandbox credentials (the app that creates payee orders). Empty = stand-in PayPal.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# 1 = one-line PayPal SDK diagnostics on stderr (never request bodies).
PAYPAL_SDK_LOG=
# Sandbox business credentials of the demo billers (Agent Toolkit calls run as the biller).
RIVERSIDE_MERCHANT_ID=
RIVERSIDE_CLIENT_ID=
RIVERSIDE_CLIENT_SECRET=
CEDAR_MERCHANT_ID=

# Money rules
# hold = AUTHORIZE now, capture after the window (release needs the biller's own app credentials).
# capture_after_window = card appears after the window, one CAPTURE order.
MATCH_MODE=hold
HOLDER_SETTLE_MINUTES=4320
SEED_DAILY_LIMIT=50
# Demo passcode for the biller console
BILLER_PASSCODE=demo-biller
# Operator key for POST /api/ops/settle (settle job trigger)
OPS_KEY=
